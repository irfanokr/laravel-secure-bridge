# Keep the distributed package lean — exclude dev-only files from `composer require`.
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/CHANGELOG.md       export-ignore

# Normalize line endings.
*.php   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
